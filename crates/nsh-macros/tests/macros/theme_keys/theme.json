{
  "tokens": {
    "colors-backgrounds-primary": { "kind": "color", "value": "#ffffff", "path": "colors.backgrounds.primary", "doc": "The page's background." },
    "ink": { "kind": "color", "value": "#101010" },
    "radius-card": { "kind": "number", "value": 12, "path": "radius.card" },
    "spacing-gutter": { "kind": "number", "value": 16, "path": "type-scale.gutter" },
    "font-weight-strong": { "kind": "number", "value": 650, "path": "type.strong" },
    "font-body": { "kind": "font", "value": "Inter", "path": "type.body.family" },
    "shadow-raised": { "kind": "shadow", "value": [{ "color": "#0000001a", "y": 1, "blur": 2 }], "path": "effects.2xl.raised" },
    "ink.brand.forest": { "kind": "color", "value": "#16a34a" },
    "ink.high-contrast.on": { "kind": "color", "value": "#000000" }
  },
  "modifiers": {
    "colorMode": {
      "default": "light",
      "contexts": {
        "light": {},
        "dark": {
          "colors-backgrounds-primary": "#0b0b0f",
          "ink": "#f0f0f0",
          "ink.brand.forest": "#4ade80",
          "ink.high-contrast.on": "#ffffff"
        }
      }
    },
    "brand": {
      "default": "ocean",
      "contexts": { "ocean": {}, "forest": { "ink": "{ink.brand.forest}" } }
    },
    "high-contrast": {
      "default": "off",
      "contexts": { "off": {}, "on": { "ink": "{ink.high-contrast.on}" } }
    }
  },
  "resolutionOrder": ["colorMode", "brand", "high-contrast"]
}
