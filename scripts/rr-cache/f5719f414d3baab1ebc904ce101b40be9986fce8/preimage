#[derive(Default)]
struct Cache {
    /// The last picture, while it shows what the view draws now.
    picture: Option<gdk::Texture>,
    /// Rendered textures.
    pool: Vec<Pooled>,
    /// The images' textures in the context, by slot (and the pixels they
    /// hold).
    images: Vec<Option<(Rc<Pixels>, glow::Texture)>>,
    /// The content's and the backdrop's textures (and their pixels).
    inputs: [Option<(Rc<Pixels>, glow::Texture)>; 4],
}

impl Drop for Cache {
    /// Its textures go when the context is next current (those GTK still
    /// draws once it hands them back).
    fn drop(&mut self) {
        let textures = self
            .images
            .drain(..)
            .chain(self.inputs.iter_mut().map(Option::take))
            .flatten()
            .map(|(_, t)| t)
            .collect::<Vec<_>>();
        let pool = std::mem::take(&mut self.pool);
        if textures.is_empty() && pool.is_empty() {
            return;
        }
        ORPHANS.with(|o| {
            let mut o = o.borrow_mut();
            o.0.extend(textures);
            o.1.extend(pool);
        });
    }
}

