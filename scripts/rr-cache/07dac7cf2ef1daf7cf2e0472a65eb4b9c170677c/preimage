            v.setHidden(hidden);
            for (l, m) in masks.iter().zip(old) {
                // SAFETY: as above.
                unsafe { l.setMask(m.as_deref()) };
            }
        }
        rgba
    });
    Picture {
        rgba,
        width,
        height,
    }
